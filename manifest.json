{
  "manifest_version": 3,
  "name": "ETLab MITS Reskin",
  "version": "1.2.0",
  "description": "Modern, high-performance dark/light reskin for ETLab with unified academic calendar, smart search, and KTU activity points tracking.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.etlab.app/*"],
  "content_scripts": [
    {
      "matches":    ["*://*.etlab.app/*"],
      "js":         ["content.js"],
      "css":        ["reskin.css"],
      "run_at":     "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ETLab Reskin",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "icons/icon128.png", "icons/toggle.png"],
      "matches":   ["*://*.etlab.app/*"]
    }
  ]
}
